# Base URL of the Realtor backend API (Laravel + Sanctum), no trailing slash.
# Defaults to http://localhost:8000 (the sibling realtor-web dev server) if unset.
# For a real field device, point this at the deployed backend, e.g.:
#   VITE_API_BASE=https://realtor.example.com
#
# This is a build-time value. A later-phase settings screen is meant to add a
# runtime override on top of it — see the TODO in src/lib/config.ts.
VITE_API_BASE=http://localhost:8000
